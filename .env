# =================================
# CONFIGURATION SUPCHAT DOCKER
# =================================

# Base de données PostgreSQL
POSTGRES_DB=supchat
POSTGRES_USER=admin
POSTGRES_PASSWORD=SuperSecretPassword2024!
DB_HOST=postgres
DB_PORT=5432

# Configuration réseau Docker
DOCKER_NETWORK=supchat-network

# JWT Configuration
JWT_SECRET=super-secret-jwt-key-change-this-in-production-environment-2024

# Backend Configuration
BACKEND_PORT=3000
BACKEND_EXTERNAL_PORT=8888
NODE_ENV=production

# Frontend Configuration
FRONTEND_PORT=80
FRONTEND_EXTERNAL_PORT=3000
REACT_APP_API_URL=http://localhost:8888

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@supchat.com
PGADMIN_DEFAULT_PASSWORD=AdminPassword2024!
PGADMIN_EXTERNAL_PORT=5050

# OAuth Google (remplacez par vos vraies valeurs)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth GitHub (remplacez par vos vraies valeurs)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Configuration S3/Scaleway Object Storage
S3_BUCKET_NAME=supchat-files
SCW_ACCESS_KEY=your-scaleway-access-key
SCW_SECRET_KEY=your-scaleway-secret-key
SCW_ENDPOINT=https://s3.fr-par.scw.cloud
SCW_REGION=fr-par

# Configuration Email (Mailjet)
# MAILJET_API_KEY=your-mailjet-api-key
# MAILJET_SECRET_KEY=your-mailjet-secret-key
# FROM_EMAIL=noreply@supchat.com

# Configuration Redis (optionnel pour les sessions)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=RedisPassword2024!

# Volumes Docker
POSTGRES_VOLUME=supchat_postgres_data
PGADMIN_VOLUME=supchat_pgadmin_data
UPLOADS_VOLUME=supchat_uploads
REDIS_VOLUME=supchat_redis_data

# Configuration SSL (pour la production)
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# Configuration des logs
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log




# JWT Secret Key (same across all files)
# Vérifier que cette clé correspond à celle utilisée pour générer les tokens
JWT_SECRET=your_secret_key

# Augmenter la durée de vie du token si nécessaire
JWT_EXPIRES_IN=7d
PORT=3000
