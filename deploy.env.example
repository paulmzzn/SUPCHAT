# =====================================
# CONFIGURATION DÉPLOIEMENT VPS
# =====================================

# Copie ce fichier vers .env et modifie les valeurs selon ton environnement

# Configuration du domaine
VPS_DOMAIN=your-domain.com
VPS_IP=your.vps.ip.address

# Configuration de l'administrateur
ADMIN_EMAIL=admin@your-domain.com

# Configuration du projet
PROJECT_DIR=/opt/supchat
COMPOSE_FILE=docker-compose.vps.yml

# Configuration SSL (optionnel)
ENABLE_SSL=false
SSL_EMAIL=admin@your-domain.com

# Configuration de sauvegarde
BACKUP_RETENTION_DAYS=7
BACKUP_TIME="0 2 * * *"  # 2h du matin tous les jours

# Configuration monitoring
MONITORING_INTERVAL=5  # minutes
ALERT_EMAIL=admin@your-domain.com

# Configuration base de données
DB_BACKUP_ENABLED=true
DB_BACKUP_COMPRESSION=true

# Configuration des ressources
MIN_MEMORY_GB=2
MIN_DISK_GB=10

# Configuration réseau
FRONTEND_PORT=80
BACKEND_PORT=3000
POSTGRES_PORT=5432
PGADMIN_PORT=8080

# Sécurité
ENABLE_FIREWALL=true
DISABLE_ROOT_LOGIN=true
CHANGE_SSH_PORT=false
NEW_SSH_PORT=2222
